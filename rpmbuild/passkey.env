# soft_fido2 per-user configuration
# This file is read as an EnvironmentFile by the passkey.service systemd unit.
# Location: ~/.fido2/passkey.env

# ── Required ─────────────────────────────────────────────────────────────────
# Directory where passkeys, the platform key, and log files are stored.
# The tilde (~) is NOT expanded by systemd EnvironmentFile — use the %h
# specifier (expanded by the service unit path, not here) or an absolute path.
FIDO_HOME=%h/.fido2

# ── Optional — uncomment and edit as needed ───────────────────────────────────

# Skip user-presence (touch) prompts — useful for automated / headless use.
# Values: true / false  (default: false)
# SOFT_FIDO2_SKIP_UP=false

# Logging level passed to Python's logging module.
# Values: DEBUG / INFO / WARNING / ERROR  (default: INFO)
# SOFT_FIDO2_DEBUG_LEVEL=INFO

# Log to a file inside FIDO_HOME instead of stdout/stderr.
# The value is a filename only (no path); the file is created in FIDO_HOME.
# SOFT_FIDO2_LOG_FILE=authenticator.log
